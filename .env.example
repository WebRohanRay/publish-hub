# ==============================================================================
# NoxWire / PublishHub — Environment Configuration Template
# ==============================================================================

# 1. Supabase Cloud Connection (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://[your-project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase CLI & Database Management (From Account Settings -> Access Tokens & Database Settings)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_ID=[your-project-ref]
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# 3. Admin Authentication & Session
SESSION_SECRET=a8f9c7e2b1d4e6f3a7c9b0e2d5f8a1c4e7b0d3f6a9c2e5b8d1f4a7c0e3b6d9f2

# 4. Adsterra Monetization Engine (Popunders, Social Bar, Native Banners)
NEXT_PUBLIC_ADSTERRA_PUBLISHER_ID=
NEXT_PUBLIC_ADSTERRA_POPUNDER_KEY=
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_KEY=
